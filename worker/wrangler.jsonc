{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iptv-cf",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",

  "assets": {
    "directory": "./assets",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iptv-cf",
      "database_id": "5b9c6e38-bc5c-48b4-82ef-e8e1c55f6c1b"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "7ed14c69568046de8cc2160a6db4bdba"
    },
    {
      "binding": "BUCKET",
      "id": "7ed14c69568046de8cc2160a6db4bdba"
    }
  ],

  "vars": {
    "GITHUB_REPO": "xu05236/iptv-cf",
    "CACHE_TTL_PLAYLIST": 60,
    "CACHE_TTL_EPG": 3600
  }
}
